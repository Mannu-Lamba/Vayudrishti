# VayuDrishti frontend configuration — copy to `.env.local` and adjust.
# Only PUBLIC values belong here: every VITE_* variable is compiled into the browser bundle.
# Never put API secrets, database credentials or model keys in frontend env files.

# Where the Vite dev/preview server forwards /api (a dev-server setting; not compiled into the bundle).
# Default http://localhost:8001 (the FastAPI port on Emergent). For a local backend on another port:
# API_PROXY_TARGET=http://127.0.0.1:3001

# Base URL of the FastAPI API, including the /api prefix. Relative "/api" (recommended) keeps the httpOnly
# session cookie same-origin: Vite proxies /api → API_PROXY_TARGET in dev (vite.config.ts).
# To call the backend directly instead, use e.g. http://127.0.0.1:8001/api — the backend must then allow
# this page's origin (CORS_ORIGINS / FRONTEND_URL in backend/.env; localhost and 127.0.0.1 on ports 3000
# and 5173 are allowed by default).
VITE_API_BASE_URL=/api

# There is no demo mode: every page reads the live FastAPI endpoints (MongoDB cyclone_database + the trained models).

# Per-request timeout in milliseconds (POST /api/ml/predict allows 30 s).
VITE_API_TIMEOUT_MS=15000

# How the registry-driven prediction section fetches in live mode:
#   resource  → GET  /api/cyclones/{id}/prediction
#   inference → POST /api/ml/predict
# Both run the same backend service and return the same body. The Track forecast panel always uses POST.
VITE_PREDICTION_STRATEGY=resource
