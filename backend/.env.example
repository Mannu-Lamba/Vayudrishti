# VayuDrishti backend configuration: copy to backend/.env and adjust. Never commit the real .env.

# MongoDB. Required at import (lib/db.py, app/core/config.py); the ML routes do not use it.
#   MONGODB_APP_DATABASE      application data: users, sessions, audit, analyst history (lib/db.py, app/db/mongo.py)
#   MONGODB_CYCLONE_DATABASE  scientific data: cyclones, positions, satellite observations, results (app/db/mongo.py)
# The older MONGO_URL / DB_NAME names are still accepted by lib/db.py when these are unset.
MONGODB_URI=mongodb://localhost:27017/
MONGODB_CYCLONE_DATABASE=cyclone_database
MONGODB_APP_DATABASE=vayudrishti_local

# Browser origins allowed to call the API cross-origin (comma-separated), plus the frontend's own URL.
# When neither is set, the local Vite origins are allowed: http://localhost:3000, http://127.0.0.1:3000,
# http://localhost:5173 and http://127.0.0.1:5173. "*" disables credentialed CORS (cookies are not sent).
# The default frontend setup (VITE_API_BASE_URL=/api through the Vite proxy) is same-origin and needs no CORS.
CORS_ORIGINS=
FRONTEND_URL=

# ML models: folder holding identification/, classification/ and prediction/ (default: backend/models).
ML_MODELS_DIR=
# "cpu" or "cuda" (default: cuda when available).
ML_DEVICE=

# Observation histories the prediction service reads (default: backend/app/data/cyclones/observations.csv.gz).
CYCLONE_DATA_PATH=

# Reported by GET /api/health (default 1.0).
APP_VERSION=
