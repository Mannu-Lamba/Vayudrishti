# Settings for docker compose. Copy to .env next to compose.yaml and fill in; git ignores .env.
# Compose substitutes these into compose.yaml, which passes them to the containers.

# Build: emergentintegrations is served from Emergent's own package index rather than PyPI, and
# routers/analyst.py imports it at startup, so the backend image cannot build without this.
EMERGENT_INDEX_URL=

# Database. The default points at the mongo service in compose.yaml. To use the MongoDB installed on this
# machine instead: MONGODB_URI=mongodb://host.docker.internal:27017
MONGODB_URI=mongodb://mongo:27017
MONGODB_APP_DATABASE=vayudrishti_local
MONGODB_CYCLONE_DATABASE=cyclone_database

# The browser origin of the site, used for CORS and for the sign-in redirect back to it.
FRONTEND_URL=http://localhost:3001

# Analyst chat. Without a key the rest of the application still works; only that chat fails.
EMERGENT_LLM_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# Accounts. ADMIN_EMAILS get the admin role on first sign-in; ALLOWED_EMAIL_DOMAINS limits who may sign in
# at all. Both are comma-separated, and both empty means the first local user becomes admin.
ADMIN_EMAILS=
ALLOWED_EMAIL_DOMAINS=

APP_VERSION=1.0
