  "readme_dataset_a": {
    "Purpose": "Editable cyclone metadata master sheet for SIH PS-70.",
    "Source": "NOAA/NCEI IBTrACS v04r01 since1980 CSV supplied by the user.",
    "Temporal filter": "SEASON >= 2000.",
    "Geographic filter": "BASIN in NI, SI, WP, EP, SP.",
    "Region mapping": "NI + AS = Arabian Sea / West India; NI + other = North Indian Ocean / Bay of Bengal; SI = Indian Ocean; WP/EP/SP = Pacific Ocean.",
    "Cyclone ID": "SID is retained as cyclone_id for storm-level grouping and leakage-safe splitting later.",
    "Timestamp": "ISO_TIME converted to a normal Excel datetime; source timestamps are UTC.",
    "Wind speed": "WMO_WIND first; USA_WIND used only when WMO_WIND is missing. Values remain in knots.",
    "Pressure": "WMO_PRES first; USA_PRES used only when WMO_PRES is missing. Values remain in millibars.",
    "Satellite images": "Intentionally not included yet; to be matched later.",
    "Image dimensions": "Intentionally not included yet; to be added with satellite data.",
    "Satellite channels": "Intentionally not included yet; to be added with satellite data.",
    "Important": "Train/validation/test splitting should later be done by cyclone_id, not by random rows/images."
  }
